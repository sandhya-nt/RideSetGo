# RideSetGo frontend environment variables
#
# Copy this file to `.env` (or `.env.production`) and adjust the values.
# Only variables prefixed with `VITE_` are exposed to the browser bundle.
# Never put a secret in this file — everything in `VITE_*` ends up in the
# shipped JavaScript.

# Base URL of the RideSetGo backend API.
#
# "/api" (the default) keeps the Vite dev proxy and same-origin deployments
# working without any configuration. Set it to the absolute backend URL
# (for example "https://api.example.com") when the frontend and the backend
# are hosted on different domains.
VITE_API_BASE=/api

# Send client-side (render) errors to the backend so they appear in the same
# operational log as the backend errors.
#
# This is OFF by default. Turning it on requires BOTH:
#   * VITE_CLIENT_ERROR_REPORTING=true here (at build time), and
#   * ENABLE_CLIENT_ERROR_REPORTING=true in the backend environment.
#
# Only the component name, a short error message, a truncated stack, the
# current route and the request id are sent. No request data, cookies,
# tokens or user identity are ever collected.
VITE_CLIENT_ERROR_REPORTING=false

# Version string reported with client error reports (optional).
VITE_APP_VERSION=0.1.0
