# ---------------------------------------------------------------------------
# RideSetGo — ignore rules
#
# Nothing in this file is required to run the application. It exists so that
# secrets, local databases and build output are not committed by accident.
# ---------------------------------------------------------------------------

# --- Secrets ---------------------------------------------------------------
# Never commit a real .env. Copy backend/.env.example to backend/.env instead
# and set your own SECRET_KEY there.
.env
.env.local
.env.*.local
*.env
!.env.example

# --- Python ----------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
*.log

# --- Node / frontend -------------------------------------------------------
node_modules/
frontend/dist/
frontend/.vite/
*.tsbuildinfo
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Local databases -------------------------------------------------------
# The application creates the SQLite file automatically, and the demo data in
# it is regenerated by scripts/seed_demo_accounts.py.
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm

# --- Logs and local artefacts ----------------------------------------------
logs/
*.log
frontend/build_out.txt
frontend/build_baseline.log
_nb_dump.txt

# --- Model artifacts -------------------------------------------------------
# The trained model is large (~300 MB). It IS required for the application to
# run, so the artifacts directory is deliberately NOT ignored. Uncomment the
# next line only if you intend to regenerate it with ml/train_model.py.
# ml/artifacts/

# --- Editors and OS --------------------------------------------------------
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini
# Jupyter notebook temporary files
.ipynb_checkpoints/
**/.ipynb_checkpoints/
# Large ML model — upload separately using Git LFS if needed
ml/artifacts/fare_model.joblib

# Jupyter temporary files
.ipynb_checkpoints/
**/.ipynb_checkpoints/

# Local databases
_doccheck.db
# ML model artifacts — publish separately if needed
ml/artifacts/
ml/artifacts/
