# RideSetGo backend environment variables
# Copy this file to .env and update values. Never commit .env with real secrets.

APP_NAME=RideSetGo
APP_VERSION=0.1.0
DEBUG=false

HOST=127.0.0.1
PORT=8000

ALLOWED_ORIGINS=http://localhost:5173

SECRET_KEY=change-me-to-a-strong-secret-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

ML_ARTIFACT_DIR=../ml/artifacts

MAP_PROVIDER=openstreetmap
# GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here  # optional, only if using Google Maps

# ---------------------------------------------------------------------------
# Monitoring & logging (Phase 19)
# See docs/MONITORING.md for the full reference. No secret values belong in
# this file — everything here is a non-sensitive setting.
# ---------------------------------------------------------------------------

# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# text (human readable) | json (one JSON object per line — use this in production)
LOG_FORMAT=text

# Optional rotating log file. Leave unset to log to stdout only, which is
# what container hosts expect.
# LOG_FILE=logs/ridesetgo.log
LOG_MAX_BYTES=5000000
LOG_BACKUP_COUNT=5

# Log the (masked) client IP with access logs. Off by default: an IP address
# is personal data.
LOG_CLIENT_IP=false

# Header used to propagate a request correlation id end-to-end.
REQUEST_ID_HEADER=X-Request-ID

# Cache window (seconds) for the readiness database probe, so frequent
# health polling never turns into a stream of database queries.
HEALTH_CHECK_CACHE_SECONDS=5

# Collect in-process operational metrics (request counts, error rates,
# latency percentiles). Read through GET /admin/system-health.
ENABLE_METRICS=true

# Accept client-side (browser) error reports at POST /diagnostics/client-errors.
# Off by default. The endpoint 404s while this is false, and it never accepts
# request data, cookies, tokens or user identity.
ENABLE_CLIENT_ERROR_REPORTING=false
